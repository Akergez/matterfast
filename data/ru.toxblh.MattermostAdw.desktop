[Desktop Entry]
Type=Application
Name=Mattermost
GenericName=Team Chat
Comment=Chat, threads and calls on a Mattermost server
Exec=mm-adw %u
Icon=ru.toxblh.MattermostAdw
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=Mattermost;chat;team;messaging;
# The SSO callback scheme. `mattermost-dev` rather than `mattermost`,
# which belongs to the official desktop app; the server picks it when the
# desktop token starts with "dev-".
MimeType=x-scheme-handler/mattermost-dev;
StartupNotify=true
