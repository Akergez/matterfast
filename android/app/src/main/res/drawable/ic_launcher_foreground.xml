        android:scaleX="0.5"
        android:scaleY="0.5"
        android:translateX="22"
        android:translateY="22">
        <!-- Front profile and the bubble tail: Blue 5 -->
        <path
            android:fillColor="#1a5fb4"
            android:pathData="M 16 70 L 40 92 L 16 106 Z M 32 28 H 96 A 16 16 0 0 1 112 44 V 76 A 16 16 0 0 1 96 92 H 32 A 16 16 0 0 1 16 76 V 44 A 16 16 0 0 1 32 28 Z" />
        <!-- Top face: Blue 3 -->
