<?xml version="1.0" encoding="utf-8"?>
<!-- The application icon, from data/icons/hicolor/scalable/apps: the same
     four paths, scaled by half and centred so that all of it — the tail
     included — stays inside the circle a launcher may cut out of the middle. -->
