            android:pathData="M 32 22 H 96 A 16 16 0 0 1 112 38 V 70 A 16 16 0 0 1 96 86 H 32 A 16 16 0 0 1 16 70 V 38 A 16 16 0 0 1 32 22 Z" />
        <!-- The bolt and its own front profile -->
        <path
            android:fillColor="#e5a50a"
            android:pathData="M 70 31 L 44 61 H 61 L 55 82 L 84 50 H 66 Z" />
        <path
            android:fillColor="#f8e45c"
            android:pathData="M 70 27 L 44 57 H 61 L 55 78 L 84 46 H 66 Z" />
    </group>
</vector>
