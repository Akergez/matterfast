# mode: demo
# size: 1320x840
#
# The server's sidebar categories are folders over the list of conversations:
# a tab narrows the list to what is filed there, in the same order, and "All"
# gives every conversation back.
wait:2500
expect:folder=inbox
move:280,102
wait:300
click:285,102
wait:800
expect:folder=Channels
expect:chats=Design Crit|General|Releases
# The first row of the folder is not the first row of everything.
move:60,157
wait:300
click:72,157
wait:1200
expect:channel=Design Crit
move:115,102
wait:300
click:120,102
wait:800
expect:folder=all
expect:chats=Development|Design Crit|General|Releases|Lena Petrova|Mikk Tamm
quit
