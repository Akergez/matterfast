# mode: demo
# size: 400x800
#
# A finger on a phone: gpui locks a pan to one axis, and the strip of folder
# tabs, which scrolls only sideways, keeps to that axis. A sideways swipe
# across it scrolls it along; an up-and-down one does not move it, where the
# strip would otherwise take the vertical movement for its own.
wait:2500
expect:page=list
expect:tabs-scroll=0
swipe:300,22,-150,0
wait:400
# A touch that stops whatever is still gliding.
swipe:300,22,0,0
wait:300
expect:tabs-scroll=206
expect:folder=inbox
swipe:300,22,0,300
wait:400
swipe:300,22,0,0
wait:300
shot:phone-swipe-tabs-vertical
expect:tabs-scroll=206
expect:folder=inbox
expect:page=list
quit
